# SQLite local e persistente por padrao.
# Para PostgreSQL, defina uma URL SQLAlchemy, por exemplo:
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost/biblioteca
DATABASE_URL=sqlite:///./biblioteca.db
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_ENV=development
FRONTEND_URL=https://localhost:5173
CORS_ORIGINS=https://localhost:5173,https://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5173
# Optional integrations: SMTP, OAuth/OIDC, LDAP and backup settings are configured by environment.
